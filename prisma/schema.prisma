// prisma/schema.prisma
datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  role      Role     @default(STAFF)
  department String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}