// prisma/schema.prisma
datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client-js"
}

model Employee {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  name       String
  role       Role     @default(STAFF)
  department String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  googleId  String   @unique
  email     String   @unique
  name      String
  role      Role     @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Team {
  id         Int      @id @default(autoincrement())
  code       String   
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

enum Role {
  ADMIN
  MANAGER
  STAFF
}